# Repository-wide ignores.
# The Flutter app has its own .gitignore in book_a_book/ — git honours both.

# Local AI assistant instructions — personal to this machine, not project config.
# The glob also catches OneDrive sync conflict copies like CLAUDE-Soph-PC.md.
CLAUDE*.md
AGENTS.md


# OS
.DS_Store
Thumbs.db
desktop.ini

# Editors
.idea/
*.iml
.vscode/*
!.vscode/launch.json
!.vscode/settings.json
!.vscode/extensions.json

# Secrets — never commit real credentials
.env
*.env
!*.example.env
dart_define.json

# Supabase CLI local state
supabase/.temp/
supabase/.branches/
